{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": {
          "type": "string",
          "enum": ["admin", "employee"]
        }
      },
      "required": ["uid", "email", "role"]
    },
    "PendingSupply": {
      "title": "Pending Supply",
      "description": "A supply request waiting for admin approval.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "requesterId": { "type": "string", "description": "User ID of the employee who created the request." },
        "requesterName": { "type": "string", "description": "Name of the employee who created the request." },
        "supplier_id": { "type": "number" },
        "storage_id": { "type": "number" },
        "comment": { "type": "string" },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ingredient_id": { "type": "number" },
              "count": { "type": "number" },
              "price": { "type": "number" }
            },
            "required": ["ingredient_id", "count", "price"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "description": "User ID of the admin who approved." },
        "approvedAt": { "type": "string", "format": "date-time" },
        "rejectedBy": { "type": "string", "description": "User ID of the admin who rejected." },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "posterSupplyId": { "type": "string", "description": "The ID of the supply created in Poster after approval." }
      },
      "required": ["status", "requesterId", "requesterName", "supplier_id", "storage_id", "ingredients", "createdAt"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents, keyed by user ID."
    },
    "/pendingSupplies/{supplyId}": {
      "schema": { "$ref": "#/entities/PendingSupply" },
      "description": "Supply requests waiting for approval."
    }
  }
}
