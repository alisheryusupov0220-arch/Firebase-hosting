/**
 * Core Philosophy: This ruleset implements a hybrid security model that combines
 * role-based access control (RBAC) for administrators with a user-ownership
 * model for transactional data. Administrators have global read/write privileges,
 * while standard authenticated users have read-only access to master data
 * and can only create and manage their own transactional records.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Checks ownership based on a 'userId' or 'recordedByUserId' field in a document.
     */
    function isDocumentOwner(doc) {
      return request.auth.uid == doc.userId || request.auth.uid == doc.recordedByUserId || request.auth.uid == doc.requesterId;
    }
    
    function isCreatingOwnDocument() {
      return request.resource.data.userId == request.auth.uid || request.resource.data.requesterId == request.auth.uid;
    }

    function isOwnershipUnchanged() {
      // Ensure the user ID field is not being changed in an update
      let newUserId = request.resource.data.userId;
      let oldUserId = resource.data.userId;
      let newRequesterId = request.resource.data.requesterId;
      let oldRequesterId = resource.data.requesterId;

      return (newUserId == oldUserId && newRequesterId == oldRequesterId);
    }

    // -------------------------------------------------------------------------
    // User and Role Collections
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Prevent user enumeration
      allow create, update, delete: if isOwner(userId);
    }

    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Application Data Collections
    // -------------------------------------------------------------------------
    
    match /ingredients_master/{ingredientId} {
      // This collection is a master list of ingredients from Poster.
      // It's not sensitive and needs to be readable by clients to populate forms
      // even before a user is logged in.
      allow read: if true;
      allow write: if isAdmin(); // Only admins (or server functions acting as admin) can sync
    }

    /**
     * @description Manages supply requests awaiting approval.
     * @allow (create) Authenticated users can create their own supply requests.
     * @allow (read, update) Owners can read/update their own requests, admins can manage any.
     */
    match /pendingSupplies/{supplyId} {
      allow get: if isSignedIn() && (isDocumentOwner(resource.data) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isCreatingOwnDocument();
      allow update: if isAdmin(); // Only admins can approve/reject
      allow delete: if isAdmin() || isDocumentOwner(resource.data);
    }

    /**
     * @description Top-level collection for ingredients, primarily for nesting price history.
     */
    match /ingredients/{ingredientId} {
      // Allow admins to manage this collection if needed, deny all others.
      allow read, write: if isAdmin();

      /**
       * @description Stores historical price data for each ingredient.
       * @allow (read) Any signed-in user can read price history for analytics.
       * @allow (write) Only admins (or the server process acting as one) can write new prices.
       */
      match /price_history/{priceId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    /**
     * @description Stores draft menu items from the Sandbox.
     * @allow Users can create, read, update, and delete their own sandbox items.
     * @allow Admins have full access.
     */
    match /sandbox_items/{sandboxId} {
      allow get, list: if isSignedIn(); // Allow listing for user's own items (enforced in query)
      allow read: if isDocumentOwner(resource.data) || isAdmin();
      allow create: if isSignedIn() && isCreatingOwnDocument();
      allow update, delete: if (isDocumentOwner(resource.data) || isAdmin()) && isOwnershipUnchanged();
    }
  }
}
